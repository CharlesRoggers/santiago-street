{
  "name": "santiago-street",
  "private": true,
  "version": "0.1.0",
  "description": "Santiago Street — open-world multiplayer street football (web 3D + Android PWA)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ss/client dev",
    "dev:server": "pnpm --filter @ss/server dev",
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './packages/*' test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
