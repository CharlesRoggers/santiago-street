# Copy to .env (never commit .env). All values are placeholders.

# --- server ---
PORT=2567
NODE_ENV=development
# Persistence adapter: "memory" (default, dev only) | "postgres" (planned)
PERSISTENCE_ADAPTER=memory
# DATABASE_URL=postgres://user:password@host:5432/santiago_street

# --- client (Vite exposes only VITE_* vars) ---
VITE_SERVER_URL=ws://localhost:2567
